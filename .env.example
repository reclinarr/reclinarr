# Reclinarr
RECLINARR_PORT=8787
RECLINARR_SESSION_SECRET=change-me-to-a-long-random-string
RECLINARR_DATA_DIR=./data
RECLINARR_PUBLIC_URL=http://localhost:8787
# Optional: enables consent-based pseudonymous product/performance metrics.
RECLINARR_POSTHOG_PROJECT_KEY=
# Set to true to disable metrics for this entire installation.
RECLINARR_TELEMETRY_DISABLED=false
# Media plane: `node` (local Vite/dev — API pipes bytes) or `nginx` (Docker — X-Accel-Redirect).
# RECLINARR_MEDIA_PLANE=node
# Docker sets MEDIA_PLANE=nginx and runs API on RECLINARR_API_PORT (loopback).
# RECLINARR_API_PORT=8788
# Embed HLS packager in the API process (default true for local; Docker runs a dedicated process).
# RECLINARR_EMBED_PACKAGER=true
# Use mock providers when backends are unavailable (dev)
RECLINARR_USE_MOCKS=false

# Jellyfin (required for Phase 2)
JELLYFIN_URL=http://jellyfin:8096

# Seerr (Phase 3+)
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

# Dispatcharr (Phase 4+)
DISPATCHARR_URL=http://dispatcharr:9191
# Preferred auth for BFF automation (Settings → API Keys):
DISPATCHARR_API_KEY=
# Alternate JWT credentials (use instead of API key if needed):
# DISPATCHARR_USERNAME=
# DISPATCHARR_PASSWORD=
# If Dispatcharr is behind Cloudflare Access, add a Service Auth token:
# DISPATCHARR_CF_ACCESS_CLIENT_ID=
# DISPATCHARR_CF_ACCESS_CLIENT_SECRET=

# Cache eviction (CACHE-mode acquisitions only)
# RECLINARR_CACHE_MAX_BYTES=53687091200
# RECLINARR_CACHE_TTL_MS=604800000

# IPTV upstream connection budget (live + VOD + downloads)
# RECLINARR_IPTV_MAX_CONNECTIONS=3

# Preferred IPTV VOD catalogue languages (comma-separated, strongest first).
# Ranks Dispatcharr variants like "EN - Title" / "IT - Title" for the same TMDb id.
# RECLINARR_PREFERRED_LANGUAGES=en
# RECLINARR_PREFERRED_LANGUAGES=it,en

# Background warm of hot Seerr discovery titles into the Dispatcharr TMDb index
# (trending/popular/genre page‑1 rails — not a full catalogue scan). Default 12 hours.
# RECLINARR_VOD_SYNC_INTERVAL_MS=43200000

# Optional ffmpeg/ffprobe (HLS packager for IPTV cache)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Bazarr serves subtitle text over its API. The browser plays it; nothing is read from local disk.
# BAZARR_URL=http://bazarr:6767
# BAZARR_API_KEY=

# HTTP
HTTP_TIMEOUT_MS=15000
