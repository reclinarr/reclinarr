{
  "expo": {
    "name": "Reclinarr",
    "slug": "reclinarr-tv",
    "version": "0.2.0-rc.1",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": [
      "reclinarr"
    ],
    "platforms": [
      "android"
    ],
    "android": {
      "package": "app.reclinarr.tv",
      "versionCode": 20001,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11141b"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "androidTVIcon": "./assets/icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "37.0.0",
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Reclinarr to use the microphone for voice search."
        }
      ],
      "./plugins/withOptionalMicrophone.js"
    ],
    "extra": {
      "eas": {
        "projectId": "reclinarr-tv"
      }
    }
  }
}
